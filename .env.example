# .env.example

# Access token secret for JWT authentication
ACCESS_TOKEN_SECRET="your_access_token_secret"

# Validity duration for access tokens
ACCESS_TOKEN_VALIDITY="15min"

# Brand name for the application
BRAND="your_brand_name"

# Database connection URL
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Environment type (development, production, etc.)
NODE_ENV="development"

# Port on which the application runs
PORT="4000"

# Refresh token secret for JWT authentication
REFRESH_TOKEN_SECRET="your_refresh_token_secret"

# Validity duration for refresh tokens
REFRESH_TOKEN_VALIDITY="7d"

# Welcome message for the API
WELCOME_MESSAGE="Welcome to the RLine API!"

# AWS S3 credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=your_bucket_region
S3_BUCKET_NAME=your_bucket_name 